{
  "name": "apex-circuit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apex Circuit - a 3D multiplayer Formula-style racing game with a from-scratch vehicle dynamics simulation.",
  "scripts": {
    "dev": "concurrently -k -n VITE,SERVER -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.smoke.mjs",
    "test:net": "node test/multiplayer.integration.mjs",
    "test:ui": "node test/ui.flow.mjs",
    "test:modes": "node test/modes.flow.mjs"
  },
  "dependencies": {
    "three": "^0.185.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
